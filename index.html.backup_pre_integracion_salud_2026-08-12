      </div>
      <button class="bot-close-btn" onclick="toggleBot()">&#x2715;</button>
    </div>
    <div class="bot-msgs" id="botMsgs"></div>
    <div class="bot-opts" id="botOpts"></div>
  </div>
  <button class="bot-toggle" onclick="toggleBot()">
    &#x1F916;
    <span class="bot-pulse" id="botPulse"></span>
  </button>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay" onclick="if(event.target===this)closeModal()">
  <div class="modal">
    <div class="modal-header">
      <h3>&#x1F455; Camiseta de la Tricolor</h3>
      <button class="modal-close" onclick="closeModal()">&#x2715;</button>
    </div>
    <div class="modal-body">
      <div class="modal-img-box"><svg viewBox="0 0 140 160" width="155" height="177"><path d="M35 22L8 58L30 64L30 138L110 138L110 64L132 58L105 22L88 34Q70 44 52 34Z" fill="#FCD116"/><path d="M35 22L8 58L30 64L30 82L8 82L8 58Z" fill="#CE1126"/><path d="M105 22L132 58L110 64L110 82L132 82L132 58Z" fill="#CE1126"/><path d="M52 22Q70 12 88 22L88 34Q70 44 52 34Z" fill="#003087"/><text x="70" y="92" text-anchor="middle" font-size="8" font-weight="900" fill="#003087" opacity=".6">FCF</text></svg></div>
      <div class="modal-details">
        <div class="modal-ref">REF: COL-CAM-2024</div>
        <div class="modal-name">Camiseta de la Tricolor 2024/25</div>
        <div class="modal-price">$85.000 <small>IVA incluido</small></div>
        <div style="font-size:.65rem;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px">Selecciona tu talla:</div>
        <span class="lbl-talla">&#x1F455; Adulto</span>
        <div class="size-selector" id="sAdulto"></div>
        <span class="lbl-talla">&#x1F466; Nino / Nina</span>
        <div class="size-selector" id="sNino"></div>
        <div class="stock-info si-none" id="stockInfo">Selecciona una talla</div>
        <div class="qty-row">
          <span class="qty-label">Cantidad:</span>
          <div class="qty-ctrl">
            <button onclick="chgQty(-1)">&#x2212;</button>
            <span id="qtyVal">1</span>
            <button onclick="chgQty(1)">+</button>
          </div>
        </div>
        <button class="modal-add-btn" id="addBtn" onclick="addFromModal()" disabled>
          &#x1F6D2; Agregar al Carrito
        </button>
      </div>
    </div>
  </div>
</div>

<!-- CARRITO -->
<div class="cart-overlay" id="cartOverlay" onclick="closeCart()"></div>
<div class="cart-drawer" id="cartDrawer">
  <div class="cart-head">
    <h3>&#x1F6D2; Mi Carrito</h3>
    <button class="cart-close" onclick="closeCart()">&#x2715;</button>
  </div>
  <div class="cart-items" id="cartItems"></div>
  <div class="cart-foot">
    <div class="cart-row"><span>Subtotal:</span><span id="cSubtotal">$0</span></div>
    <div class="cart-row"><span>Envio:</span><span>A convenir</span></div>
    <div class="cart-total-row"><span>Total:</span><span id="cTotal">$0</span></div>
    <button class="ws-order-btn" id="wsOrderBtn" onclick="sendOrder()" disabled>
      &#x1F4AC; Enviar Pedido por WhatsApp
    </button>
    <p class="cart-note">Te contactaremos para confirmar disponibilidad y pago</p>
  </div>
</div>

<script>
var WS='573123693318';
var PROD={
  adulto:{S:15,M:20,L:18,XL:14,XXL:8},
  nino:{T4:10,T6:12,T8:12,T10:10,T12:8,T14:6}
};
PROD.all=Object.assign({},PROD.adulto,PROD.nino);
var LINES=[
  {k:'deportiva', i:'&#x1F455;', l:'Linea Deportiva',
   m:'Tenemos la <strong>Camiseta de la Tricolor 2024/25</strong> a precio unico <strong>$85.000</strong>. Tallas adulto S M L XL XXL y nino T4 al T14.'},
  {k:'perfumeria',i:'&#x1F490;',l:'Perfumeria Premium',
   m:'Fragancias originales para el y para ella de las mejores marcas. Consultanos para precios.'},
  {k:'naturales', i:'&#x1F33F;',l:'Productos Naturales Premium',
   m:'Productos naturales de alta calidad para cuidado y bienestar. Contactanos para el catalogo.'},
  {k:'aseo',      i:'&#x1F9F9;',l:'Aseo Industrial y Hogar',
   m:'Soluciones de limpieza para empresas y hogares. Escríbenos para cotizaciones.'}
];
var cart=[],selSize=null,qty=1,curFilter='all';
var botOpen=false,botStarted=false;
var slideIdx=0,NSLIDES=7,slideTimer=null;

function goWS(msg){
  var u='https://wa.me/'+WS+'?text='+encodeURIComponent(msg);
  window.location.href=u;
}
function showToast(msg){
  var t=document.getElementById('toast');
  t.textContent=msg;t.classList.add('show');
  clearTimeout(window._tt);
  window._tt=setTimeout(function(){t.classList.remove('show');},3000);
}
function fmt(n){return '$'+Number(n).toLocaleString('es-CO');}

/* SLIDER */
function buildDots(){
  var d=document.getElementById('sliderDots'),h='';
  for(var i=0;i<NSLIDES;i++)
    h+='<button class="dot'+(i===0?' active':'')
      +'" onclick="goSlide('+i+')" aria-label="Slide '+(i+1)+'"></button>';
  d.innerHTML=h;
}
function updSlider(){
  document.getElementById('slidesTrack').style.transform='translateX(-'+(slideIdx*100)+'%)';
  document.getElementById('slideCounter').textContent=(slideIdx+1)+' / '+NSLIDES;
  document.querySelectorAll('.dot').forEach(function(d,i){
    d.classList.toggle('active',i===slideIdx);
  });
}
function slideGo(dir){
  slideIdx=(slideIdx+dir+NSLIDES)%NSLIDES;
  updSlider();clearInterval(slideTimer);
  slideTimer=setInterval(function(){slideGo(1);},5000);
}
function goSlide(i){
  slideIdx=i;updSlider();clearInterval(slideTimer);
  slideTimer=setInterval(function(){slideGo(1);},5000);
}

/* TOUCH SWIPE */
function initSwipe(){
  var el=document.getElementById('slidesTrack'),sx=0;
  el.addEventListener('touchstart',function(e){sx=e.touches[0].clientX;},{passive:true});
  el.addEventListener('touchend',function(e){
    var dx=e.changedTouches[0].clientX-sx;
    if(Math.abs(dx)>45) slideGo(dx<0?1:-1);
  },{passive:true});
}

/* FILTRO */
function setFilter(f,el){
  curFilter=f;
  document.querySelectorAll('.chip').forEach(function(c){c.classList.remove('active');});
  el.classList.add('active');
  renderProducts();
}
function renderProducts(){
  var sizes = curFilter==='adulto' ? PROD.adulto : curFilter==='nino' ? PROD.nino : PROD.all;
  var tags = Object.keys(sizes).map(function(s){return '<span class="size-tag">'+s+'</span>';}).join('');
  document.getElementById('productsGrid').innerHTML =
    '<div class="product-card" onclick="openModal()">'
    +'<div class="product-image"><svg viewBox="0 0 140 160" width="100" height="114"><path d="M35 22L8 58L30 64L30 138L110 138L110 64L132 58L105 22L88 34Q70 44 52 34Z" fill="#FCD116"/><path d="M35 22L8 58L30 64L30 82L8 82L8 58Z" fill="#CE1126"/><path d="M105 22L132 58L110 64L110 82L132 82L132 58Z" fill="#CE1126"/><path d="M52 22Q70 12 88 22L88 34Q70 44 52 34Z" fill="#003087"/><text x="70" y="92" text-anchor="middle" font-size="8" font-weight="900" fill="#003087" opacity=".6">FCF</text></svg></div>'
    +'<div class="product-info">'
    +'<div class="product-ref">REF: COL-CAM-2024</div>'
    +'<div class="product-name">Camiseta de la Tricolor 2024/25</div>'
    +'<div class="product-sizes">'+tags+'</div>'
    +'<div class="product-footer">'
    +'<div class="product-price">'+fmt(85000)+'<small>IVA incluido</small></div>'
    +'<button class="add-btn" onclick="event.stopPropagation();openModal()">Seleccionar Talla</button>'
    +'</div></div></div>';
  var count = document.getElementById('productCount');
  if(count) count.textContent = curFilter==='adulto' ? 'Tallas Adulto (S-XXL)' : curFilter==='nino' ? 'Tallas Nino (T4-T14)' : 'Todas las tallas';
}

/* MODAL — botones de talla con onclick inline */
function openModal(){
  selSize=null;qty=1;
  document.getElementById('qtyVal').textContent='1';
  document.getElementById('stockInfo').className='stock-info si-none';
  document.getElementById('stockInfo').textContent='Selecciona una talla';
  document.getElementById('addBtn').disabled=true;
  document.getElementById('sAdulto').innerHTML=makeSizeBtns(PROD.adulto);
  document.getElementById('sNino').innerHTML=makeSizeBtns(PROD.nino);
  document.getElementById('modalOverlay').classList.add('open');
  document.body.style.overflow='hidden';
}
function makeSizeBtns(obj){
  return Object.entries(obj).map(function(e){
    var s=e[0],q=e[1];
    if(q===0) return '<button class="size-btn disabled" disabled>'+s+'<span class="ss">Agot.</span></button>';
    return '<button class="size-btn" onclick="selTalla(this,\''+s+'\','+q+')">'+s+'<span class="ss">'+q+' uds</span></button>';
  }).join('');
}
function selTalla(btn,s,q){
  selSize=s;qty=1;
  document.getElementById('qtyVal').textContent='1';
  document.querySelectorAll('.size-btn').forEach(function(b){b.classList.remove('selected');});
  btn.classList.add('selected');
  var si=document.getElementById('stockInfo');
  if(q<=3){si.className='stock-info si-low';si.textContent='Solo '+q+' unidades en talla '+s;}
  else{si.className='stock-info si-ok';si.textContent=q+' unidades disponibles - Talla '+s;}
  document.getElementById('addBtn').disabled=false;
}
function chgQty(d){
  if(!selSize)return;
  qty=Math.max(1,Math.min(qty+d,PROD.all[selSize]||0));
  document.getElementById('qtyVal').textContent=qty;
}
function addFromModal(){
  if(!selSize)return;
  var ex=cart.find(function(i){return i.s===selSize;});
  if(ex) ex.q=Math.min(ex.q+qty,PROD.all[selSize]||0);
  else cart.push({s:selSize,q:qty,p:85000});
  closeModal();
  updBadge();
  openCart();
  showToast('Talla '+selSize+' agregada');
}
function closeModal(){
  document.getElementById('modalOverlay').classList.remove('open');
  document.body.style.overflow='';
  selSize=null;
}

/* CARRITO PRODUCTOS NATURALES */
function addProductCart(name, price, emoji){
  var ex=cart.find(function(i){return i.s===name;});
  if(ex){ex.q+=1;}
  else{cart.push({n:name,q:1,p:price,emoji:emoji||'&#x1F33F;'});}
  updBadge();
  openCart();
  showToast('¡'+name+' agregado al carrito!');
}
/* CARRITO */
function updBadge(){
  var n=cart.reduce(function(s,i){return s+i.q;},0);
  var b=document.getElementById('cartBadge');
  b.style.display=n>0?'flex':'none';
  b.textContent=n;
}
function openCart(){
  renderCart();
  document.getElementById('cartOverlay').classList.add('open');
  document.getElementById('cartDrawer').classList.add('open');
  document.body.style.overflow='hidden';
}
function closeCart(){
  document.getElementById('cartOverlay').classList.remove('open');
  document.getElementById('cartDrawer').classList.remove('open');
  document.body.style.overflow='';
}
function removeItem(i){
  cart.splice(i,1);
  updBadge();
  renderCart();
}
function renderCart(){
  var c=document.getElementById('cartItems');
  if(!cart.length){
    c.innerHTML='<div class="cart-empty"><div class="icon">&#x1F6D2;</div><p>Carrito vacio</p><small>Elige una talla para agregar</small></div>';
    document.getElementById('wsOrderBtn').disabled=true;
    document.getElementById('cSubtotal').textContent='$0';
    document.getElementById('cTotal').textContent='$0';
    return;
  }
  c.innerHTML=cart.map(function(item,i){
    return '<div class="cart-item">'
      +(item.n? '<div class="cart-item-img" style="font-size:1.8rem;background:#f8f8f8">'+item.emoji+'</div>': '<div class="cart-item-img"><svg viewBox="0 0 140 160" width="46" height="52"><path d="M35 22L8 58L30 64L30 138L110 138L110 64L132 58L105 22L88 34Q70 44 52 34Z" fill="#FCD116"/><path d="M35 22L8 58L30 64L30 82L8 82L8 58Z" fill="#CE1126"/><path d="M105 22L132 58L110 64L110 82L132 82L132 58Z" fill="#CE1126"/><path d="M52 22Q70 12 88 22L88 34Q70 44 52 34Z" fill="#003087"/></svg></div>')
      +'<div class="cart-item-info">'
      +'<div class="cart-item-name">'+(item.n||'Camiseta de la Tricolor')+'</div>'
      +(item.n? '<div class="cart-item-meta">Cant: '+item.q+'</div>': '<div class="cart-item-meta">COL-CAM-2024 &bull; Talla: '+item.s+' &bull; Cant: '+item.q+'</div>')
      +'<div class="cart-item-price">'+fmt(item.p*item.q)+'</div>'
      +'</div>'
      +'<button class="cart-item-remove" onclick="removeItem('+i+')">&#x1F5D1;</button>'
      +'</div>';
  }).join('');
  var sub=cart.reduce(function(s,i){return s+i.p*i.q;},0);
  document.getElementById('cSubtotal').textContent=fmt(sub);
  document.getElementById('cTotal').textContent=fmt(sub);
  document.getElementById('wsOrderBtn').disabled=false;
}

/* PEDIDO WHATSAPP */
function sendOrder(){
  if(!cart.length)return;
  var lines=['PEDIDO - Punto Multimarcas','================================'];
  cart.forEach(function(item,i){
    lines.push('');
    lines.push((i+1)+'. '+(item.n||'Camiseta de la Tricolor'));
    if(!item.n) lines.push('   Ref: COL-CAM-2024');
    lines.push(item.n ? '   Cant: '+item.q : '   Talla: '+item.s+'  Cant: '+item.q);
    lines.push('   Subtotal: '+fmt(item.p*item.q));
  });
  var total=cart.reduce(function(s,i){return s+i.p*i.q;},0);
  lines.push('');
  lines.push('================================');
  lines.push('TOTAL: '+fmt(total));
  lines.push('');
  lines.push('Cra. 77G Bis No. 63-17 - Bosa Estacion, Bogota');
  lines.push('Confirmar disponibilidad y pago. Gracias!');
  goWS(lines.join('\n'));
}

/* BOT */
function toggleBot(){
  botOpen=!botOpen;
  document.getElementById('botChat').classList.toggle('open',botOpen);
  var p=document.getElementById('botPulse');
  if(p) p.style.display=botOpen?'none':'block';
  if(botOpen&&!botStarted){botStarted=true;startBot();}
}
function startBot(){
  document.getElementById('botMsgs').innerHTML='';
  setTimeout(function(){
    addBotMsg('<strong>Hola!</strong> Soy el asistente de Punto Multimarcas. En que te puedo ayudar?');
    showBotMenu();
  },500);
}
function addBotMsg(h,isUser){
  var m=document.getElementById('botMsgs');
  var d=document.createElement('div');
  d.className='bmsg '+(isUser?'usr':'bot');
  d.innerHTML=h;
  m.appendChild(d);
  m.scrollTop=m.scrollHeight;
}
function showBotMenu(){
  var o=document.getElementById('botOpts');
  var h='<div class="bot-opt-lbl">Selecciona una linea:</div>';
  LINES.forEach(function(ln,idx){
    h+='<button class="bot-opt" onclick="botLine('+idx+')">'+ln.i+' '+ln.l+'</button>';
  });
  h+='<button class="bot-opt" onclick="botOther()">&#x2753; Otra consulta</button>';
  o.innerHTML=h;
}
function botLine(idx){
  var ln=LINES[idx];
  addBotMsg(ln.i+' '+ln.l,true);
  setTimeout(function(){
    addBotMsg(ln.i+' <strong>'+ln.l+'</strong><br><br>'+ln.m);
    document.getElementById('botOpts').innerHTML=
      '<button class="bot-ws" onclick="goWS(\'Hola! Me interesa '+ln.l+' de Punto Multimarcas.\')">&#x1F4AC; Chatear por WhatsApp</button>'
      +'<button class="bot-back" onclick="addBotMsg(\'En que mas te puedo ayudar?\');showBotMenu()">&#x2190; Volver</button>';
  },400);
}
function botOther(){
  addBotMsg('&#x2753; Otra consulta',true);
  setTimeout(function(){
    addBotMsg('Con gusto te ayudamos. Escríbenos y un asesor te atendera.');
    document.getElementById('botOpts').innerHTML=
      '<button class="bot-ws" onclick="goWS(\'Hola! Tengo una consulta sobre Punto Multimarcas.\')">&#x1F4AC; Chatear por WhatsApp</button>'
      +'<button class="bot-back" onclick="addBotMsg(\'En que mas te puedo ayudar?\');showBotMenu()">&#x2190; Volver</button>';
  },400);
}

/* INIT */
window.addEventListener('load',function(){
  buildDots();
  updSlider();
  slideTimer=setInterval(function(){slideGo(1);},5000);
  renderProducts();
  initSwipe();
  setTimeout(function(){if(!botStarted&&!botOpen)toggleBot();},4000);
});
</script>
</body>
</html>


