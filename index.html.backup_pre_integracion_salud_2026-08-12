﻿<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Punto Multimarcas - El Secreto de la Calidad</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--blue:#003087;--red:#CE1126;--yellow:#FCD116;--gray:#6c757d;--light:#f8f9fa;--dark:#1a1a2e;--white:#fff;--border:#dee2e6;--shadow:0 4px 20px rgba(0,0,0,.10);--radius:12px}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--light);color:#333;overflow-x:hidden;}
button,a{touch-action:manipulation;-webkit-tap-highlight-color:transparent;cursor:pointer}
header{background:#fff;border-bottom:3px solid var(--red);position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(0,0,0,.08)}
.header-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:8px 16px;gap:12px}
.logo-area{display:flex;align-items:center;gap:8px;flex-shrink:0}
.logo-svg{width:52px;height:52px}
.brand-text h1{font-size:1.1rem;color:var(--blue);font-weight:900;line-height:1.1}
.brand-text p{font-size:.6rem;color:var(--red);font-weight:700;letter-spacing:1px;text-transform:uppercase}
nav{display:flex;gap:2px;flex-wrap:wrap}
nav a{padding:6px 10px;border-radius:8px;font-size:.75rem;font-weight:600;color:#333;transition:all .2s;white-space:nowrap;text-decoration:none}
nav a:hover,nav a.active{background:var(--blue);color:#fff}
nav a.np:hover{background:#8B008B}
nav a.nn:hover{background:#2e7d32}
nav a.na:hover{background:#0277BD}
.header-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
.search-box{display:flex;align-items:center;gap:6px;background:var(--light);border:1.5px solid var(--border);border-radius:24px;padding:5px 12px}
.search-box input{border:none;background:none;outline:none;font-size:.8rem;width:110px}
.cart-btn{position:relative;background:var(--blue);color:#fff;border:none;border-radius:10px;padding:9px 16px;font-weight:700;display:flex;align-items:center;gap:5px;font-size:.85rem;transition:background .2s}
.cart-btn:hover{background:var(--red)}
.cart-badge{position:absolute;top:-6px;right:-6px;background:var(--red);color:#fff;border-radius:50%;width:20px;height:20px;font-size:.65rem;font-weight:700;display:none;align-items:center;justify-content:center}
.hero-slider{position:relative;width:100%;height:480px;overflow:hidden;background:var(--dark)}
.slides-track{display:flex;height:100%;transition:transform .65s cubic-bezier(.4,0,.2,1);will-change:transform}
.slide{min-width:100%;width:100%;height:100%;flex-shrink:0;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.slide-1{background:linear-gradient(135deg,#001a5e,#003087,#001235)}
.slide-2{background:linear-gradient(135deg,#001a5e,#002a70,#001235)}
.slide-3{background:linear-gradient(135deg,#0d3b1a,#1b6b32,#051a0a)}
.slide-img-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center}
.slide-content{position:relative;z-index:3;display:flex;align-items:center;gap:48px;padding:0 60px;width:100%;max-width:1200px}
.slide-text{flex:1}
.slide-flag{display:flex;height:5px;width:120px;border-radius:3px;overflow:hidden;margin-bottom:16px}
.slide-flag span{flex:1}
.slide-flag span:nth-child(1){background:var(--yellow);flex:2}
.slide-flag span:nth-child(2){background:var(--blue)}
.slide-flag span:nth-child(3){background:var(--red)}
.slide-eyebrow{display:inline-block;padding:4px 14px;border-radius:20px;font-size:.7rem;font-weight:800;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px}
.s1-eye{background:var(--yellow);color:var(--dark)}
.s3-eye{background:#C8F5D0;color:#0d3b1a}
.slide-text h2{font-size:2.4rem;font-weight:900;line-height:1.05;color:#fff;margin-bottom:10px}
.slide-text h2 span{display:block}
.slide-text p{color:rgba(255,255,255,.72);font-size:.9rem;margin-bottom:20px;line-height:1.5}
.slide-cta{display:inline-flex;align-items:center;gap:8px;padding:11px 22px;border-radius:10px;font-weight:800;font-size:.88rem;border:none;transition:all .2s}
.s1-cta{background:var(--yellow);color:var(--dark)}
.s1-cta:hover{background:#ffe033;transform:translateY(-2px)}
.s3-cta{background:#C8F5D0;color:#0d3b1a}
.s3-cta:hover{background:#fff;transform:translateY(-2px)}
.slide-visual{flex-shrink:0;display:flex;align-items:center;justify-content:center}
.slide-ovbtn{position:absolute;inset:0;z-index:2;display:flex;align-items:flex-end;justify-content:flex-end;padding:28px 44px;pointer-events:none}
.slide-ovbtn button{background:transparent;border:none;width:220px;height:120px;border-radius:12px;pointer-events:all}
.slider-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:50;background:rgba(0,0,0,.5);border:2px solid rgba(255,255,255,.3);color:#fff;width:44px;height:44px;border-radius:50%;font-size:1.4rem;transition:background .2s;display:flex;align-items:center;justify-content:center;border:none}
.slider-arrow:hover{background:rgba(0,0,0,.75)}
.arrow-prev{left:12px}.arrow-next{right:12px}
.slider-dots{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:50}
.dot{width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.4);transition:all .3s;border:none;padding:0}
.dot.active{background:#fff;width:24px;border-radius:4px}
.slide-counter{position:absolute;top:12px;right:14px;z-index:50;color:rgba(255,255,255,.8);font-size:.72rem;font-weight:700;background:rgba(0,0,0,.35);padding:2px 8px;border-radius:10px}
.filter-bar{background:#fff;border-bottom:1px solid var(--border);padding:10px 16px}
.filter-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.filter-label{font-size:.72rem;font-weight:700;color:var(--gray);text-transform:uppercase;letter-spacing:1px}
.chip{padding:5px 14px;border-radius:20px;font-size:.75rem;font-weight:600;border:1.5px solid var(--border);background:#fff;color:#555;transition:all .2s}
.chip:hover,.chip.active{background:var(--blue);color:#fff;border-color:var(--blue)}
.catalog-section{max-width:1200px;margin:0 auto;padding:24px 16px}
.section-title{display:flex;align-items:center;gap:10px;margin-bottom:20px}
.section-title h3{font-size:1.2rem;font-weight:800;color:var(--dark)}
.section-title .line{flex:1;height:2px;background:var(--border)}
.section-title .count{font-size:.73rem;color:var(--gray);background:var(--light);padding:3px 10px;border-radius:20px;white-space:nowrap}
.products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px}
.product-card{background:#fff;border-radius:var(--radius);box-shadow:var(--shadow);overflow:hidden;border:1.5px solid transparent;transition:transform .25s,box-shadow .25s;cursor:pointer}
.product-card:hover{transform:translateY(-4px);box-shadow:0 8px 32px rgba(0,0,0,.14);border-color:var(--blue)}
.product-image{height:200px;position:relative;display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,#FFF9DB,#FFF3A0)}
.badge-hot{position:absolute;top:10px;left:10px;background:var(--red);color:#fff;padding:3px 10px;border-radius:12px;font-size:.65rem;font-weight:800;text-transform:uppercase}
.stock-dot{position:absolute;top:10px;right:10px;width:10px;height:10px;border-radius:50%;background:#28a745}
.product-info{padding:14px}
.product-ref{font-size:.63rem;color:var(--gray);font-weight:700;text-transform:uppercase;margin-bottom:3px}
.product-name{font-size:.92rem;font-weight:700;color:var(--dark);margin-bottom:6px;line-height:1.3}
.product-sizes{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:10px}
.size-tag{font-size:.6rem;font-weight:700;padding:2px 7px;border:1.5px solid var(--border);border-radius:6px;color:#555}
.product-footer{display:flex;align-items:center;justify-content:space-between;gap:8px}
.product-price{font-size:1.15rem;font-weight:900;color:var(--blue)}
.product-price small{font-size:.63rem;font-weight:500;color:var(--gray);display:block}
.add-btn{background:var(--blue);color:#fff;border:none;border-radius:8px;padding:10px 16px;font-size:.82rem;font-weight:700;white-space:nowrap;flex-shrink:0;transition:background .2s}
.add-btn:hover{background:var(--red)}
.features{background:#fff;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:18px 16px}
.features-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:16px}
.feature{display:flex;align-items:center;gap:10px}
.feature-icon{font-size:1.5rem}
.feature-text strong{display:block;font-size:.78rem;font-weight:700;color:var(--dark)}
.feature-text span{font-size:.68rem;color:var(--gray)}
footer{background:var(--dark);color:#fff;padding:36px 16px 20px}
.footer-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:24px;margin-bottom:24px}
.footer-brand h4{font-size:.95rem;font-weight:800;color:var(--yellow);margin-bottom:8px}
.footer-brand p{font-size:.74rem;color:rgba(255,255,255,.5);line-height:1.6}
.footer-col h5{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--red);margin-bottom:8px}
.footer-col ul{list-style:none}
.footer-col ul li{padding:2px 0;font-size:.74rem;color:rgba(255,255,255,.6)}
.footer-col ul li strong{color:rgba(255,255,255,.9)}
.footer-bottom{border-top:1px solid rgba(255,255,255,.1);padding-top:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.footer-bottom p{font-size:.68rem;color:rgba(255,255,255,.35)}
.ws-float{position:fixed;bottom:20px;right:20px;z-index:999;background:#25D366;color:#fff;border:none;border-radius:50%;width:54px;height:54px;box-shadow:0 4px 16px rgba(37,211,102,.45);display:flex;align-items:center;justify-content:center;transition:transform .2s}
.ws-float:hover{transform:scale(1.1)}
.bot-widget{position:fixed;bottom:84px;right:20px;z-index:998;display:flex;flex-direction:column;align-items:flex-end}
.bot-toggle{width:54px;height:54px;border-radius:50%;border:none;background:var(--blue);color:#fff;font-size:1.35rem;box-shadow:0 4px 16px rgba(0,48,135,.4);display:flex;align-items:center;justify-content:center;transition:transform .2s;margin-top:8px;position:relative}
.bot-toggle:hover{transform:scale(1.08)}
.bot-pulse{position:absolute;top:-3px;right:-3px;width:13px;height:13px;background:var(--red);border-radius:50%;border:2px solid #fff;animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.3);opacity:.6}}
.bot-chat{width:310px;background:#fff;border-radius:16px;box-shadow:0 8px 40px rgba(0,0,0,.22);overflow:hidden;margin-bottom:10px;display:none;flex-direction:column;max-height:470px}
.bot-chat.open{display:flex}
.bot-chat-head{background:var(--blue);padding:12px 14px;display:flex;align-items:center;gap:10px}
.bot-avatar{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:1rem;border:2px solid rgba(255,255,255,.3)}
.bot-head-info strong{display:block;color:#fff;font-size:.84rem;font-weight:700}
.bot-head-info span{color:rgba(255,255,255,.7);font-size:.68rem}
.bot-online{width:7px;height:7px;background:#4dff91;border-radius:50%;display:inline-block;margin-right:4px}
.bot-close-btn{margin-left:auto;background:none;border:none;color:rgba(255,255,255,.8);font-size:1rem;padding:6px;border-radius:6px}
.bot-msgs{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px;background:#f0f2f5}
.bmsg{max-width:88%;padding:9px 12px;border-radius:12px;font-size:.8rem;line-height:1.45}
.bmsg.bot{background:#fff;border-radius:4px 12px 12px 12px;color:#333;box-shadow:0 1px 4px rgba(0,0,0,.08)}
.bmsg.usr{background:var(--blue);color:#fff;border-radius:12px 12px 4px 12px;align-self:flex-end}
.bot-opts{padding:8px 10px 12px;background:#fff;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:5px}
.bot-opt-lbl{font-size:.65rem;color:var(--gray);font-weight:700;text-transform:uppercase;margin-bottom:2px}
.bot-opt{padding:10px 12px;border:1.5px solid var(--border);border-radius:8px;background:#fff;text-align:left;font-size:.8rem;font-weight:600;color:#333;transition:all .18s;display:flex;align-items:center;gap:7px;width:100%}
.bot-opt:hover,.bot-opt:active{border-color:var(--blue);color:var(--blue);background:#f0f4ff}
.bot-ws{padding:11px;border:none;border-radius:8px;background:#25D366;color:#fff;font-size:.82rem;font-weight:700;display:flex;align-items:center;justify-content:center;gap:5px;margin-top:3px;transition:background .2s;width:100%}
.bot-ws:hover{background:#128C7E}
.bot-back{padding:7px 10px;background:var(--light);border:none;border-radius:6px;font-size:.72rem;color:var(--gray);font-weight:600;width:100%;text-align:left}
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:2000;align-items:center;justify-content:center;padding:12px}
.modal-overlay.open{display:flex}
.modal{background:#fff;border-radius:16px;width:100%;max-width:640px;max-height:94vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.3)}
.modal-header{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--border);position:sticky;top:0;background:#fff;z-index:1;border-radius:16px 16px 0 0}
.modal-header h3{font-size:.95rem;font-weight:700;color:var(--dark)}
.modal-close{background:var(--light);border:none;border-radius:8px;width:32px;height:32px;font-size:.95rem;display:flex;align-items:center;justify-content:center}
.modal-body{display:flex;gap:20px;padding:20px}
.modal-img-box{flex-shrink:0;width:180px;height:210px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,#FFF9DB,#FFF3A0)}
.modal-details{flex:1;min-width:0}
.modal-ref{font-size:.65rem;color:var(--gray);font-weight:700;text-transform:uppercase;margin-bottom:3px}
.modal-name{font-size:1.05rem;font-weight:800;color:var(--dark);margin-bottom:6px}
.modal-price{font-size:1.5rem;font-weight:900;color:var(--blue);margin-bottom:12px}
.modal-price small{font-size:.68rem;font-weight:500;color:var(--gray)}
.lbl-talla{font-size:.65rem;font-weight:700;color:var(--blue);text-transform:uppercase;letter-spacing:.5px;margin:8px 0 6px;padding:2px 7px;background:#E8F0FE;border-radius:4px;display:inline-block}
.size-selector{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px}
.size-btn{padding:10px 14px;border:2px solid var(--border);border-radius:8px;background:#fff;font-weight:700;font-size:.82rem;transition:all .2s;min-height:46px;min-width:46px;display:inline-flex;flex-direction:column;align-items:center;justify-content:center;border:2px solid var(--border)}
.size-btn:hover{border-color:var(--blue);color:var(--blue)}
.size-btn.selected{border-color:var(--blue);background:var(--blue);color:#fff}
.size-btn.disabled{color:#ccc;border-color:#eee;cursor:not-allowed;pointer-events:none}
.ss{font-size:.54rem;font-weight:400}
.stock-info{padding:8px 12px;border-radius:8px;font-size:.78rem;font-weight:600;margin-bottom:10px}
.si-none{background:var(--light);color:var(--gray)}
.si-ok{background:#d4edda;color:#155724}
.si-low{background:#fff3cd;color:#856404}
.qty-row{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.qty-label{font-size:.74rem;font-weight:700;color:var(--gray)}
.qty-ctrl{display:flex;align-items:center;border:2px solid var(--border);border-radius:8px;overflow:hidden}
.qty-ctrl button{width:36px;height:36px;border:none;background:var(--light);font-size:1.1rem;font-weight:700}
.qty-ctrl button:hover{background:var(--border)}
.qty-ctrl span{width:40px;text-align:center;font-weight:700;font-size:.9rem}
.modal-add-btn{width:100%;padding:13px;background:var(--blue);color:#fff;border:none;border-radius:10px;font-size:.95rem;font-weight:700;transition:background .2s;display:flex;align-items:center;justify-content:center;gap:7px}
.modal-add-btn:hover,.modal-add-btn:active{background:var(--red)}
.modal-add-btn:disabled{background:#ccc}
.cart-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:3000}
.cart-overlay.open{display:block}
.cart-drawer{position:fixed;right:-420px;top:0;bottom:0;width:400px;max-width:100vw;background:#fff;box-shadow:-8px 0 40px rgba(0,0,0,.15);z-index:3001;transition:right .3s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column}
.cart-drawer.open{right:0}
.cart-head{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:var(--blue);color:#fff}
.cart-head h3{font-size:.95rem;font-weight:700}
.cart-close{background:rgba(255,255,255,.15);border:none;color:#fff;border-radius:8px;width:32px;height:32px;font-size:1.1rem;display:flex;align-items:center;justify-content:center}
.cart-items{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px}
.cart-empty{text-align:center;padding:50px 20px;color:var(--gray)}
.cart-empty .icon{font-size:2.5rem;margin-bottom:10px}
.cart-item{display:flex;gap:10px;background:var(--light);border-radius:10px;padding:10px;align-items:center}
.cart-item-img{width:52px;height:52px;border-radius:8px;flex-shrink:0;background:linear-gradient(160deg,#FFF9DB,#FFF3A0);display:flex;align-items:center;justify-content:center}
.cart-item-info{flex:1;min-width:0}
.cart-item-name{font-size:.8rem;font-weight:700;color:var(--dark);margin-bottom:2px}
.cart-item-meta{font-size:.68rem;color:var(--gray);margin-bottom:3px}
.cart-item-price{font-size:.86rem;font-weight:800;color:var(--blue)}
.cart-item-remove{background:none;border:none;color:#dc3545;font-size:1rem;padding:6px;flex-shrink:0}
.cart-foot{padding:14px 18px;border-top:1px solid var(--border)}
.cart-row{display:flex;justify-content:space-between;font-size:.8rem;margin-bottom:5px}
.cart-total-row{display:flex;justify-content:space-between;font-size:1.05rem;font-weight:800;color:var(--blue);margin-bottom:14px;border-top:1px solid var(--border);padding-top:9px}
.ws-order-btn{width:100%;padding:14px;background:#25D366;color:#fff;border:none;border-radius:12px;font-size:.95rem;font-weight:800;display:flex;align-items:center;justify-content:center;gap:7px;transition:background .2s}
.ws-order-btn:hover,.ws-order-btn:active{background:#128C7E}
.ws-order-btn:disabled{background:#ccc}
.cart-note{font-size:.63rem;color:var(--gray);text-align:center;margin-top:7px}
.toast{position:fixed;bottom:90px;right:18px;z-index:5000;background:var(--dark);color:#fff;padding:11px 16px;border-radius:10px;font-size:.8rem;font-weight:600;box-shadow:0 4px 20px rgba(0,0,0,.25);transform:translateX(130%);transition:transform .3s;pointer-events:none;max-width:260px}
.toast.show{transform:translateX(0)}
#inicio,#deportiva,#salud,#gomitas,#fitness,#perfumeria,#naturales,#aseo{scroll-margin-top:80px}
@media(max-width:768px){
  nav{display:none}.search-box{display:none}
  .brand-text p{display:none}
  .header-inner{padding:8px 10px}
  .logo-svg{width:44px;height:44px}
  .brand-text h1{font-size:.88rem}
  .cart-btn{padding:9px 14px;font-size:.82rem}
  .hero-slider{height:210px}
  .slide-content{padding:0 10px;gap:10px}
  .slide-visual{display:none}
  .slide-text h2{font-size:1.1rem;margin-bottom:5px}
  .slide-text p{display:none}
  .slide-eyebrow,.slide-flag{display:none}
  .slide-cta{padding:8px 16px;font-size:.76rem}
  .slider-arrow{width:36px;height:36px;font-size:1.1rem}
  .arrow-prev{left:6px}.arrow-next{right:6px}
  .catalog-section{padding:16px 10px}
  .section-title h3{font-size:1rem}
  .products-grid{grid-template-columns:1fr}
  .product-card{width:100%}
  .product-image{height:165px}
  .product-name{font-size:.88rem}
  .add-btn{padding:11px 16px;font-size:.8rem}
  .features-inner{grid-template-columns:1fr 1fr}
  .footer-inner{grid-template-columns:1fr 1fr}
  .modal-body{flex-direction:column;padding:14px;gap:12px}
  .modal-img-box{width:100%;height:150px}
  .modal-name{font-size:.9rem}
  .modal-price{font-size:1.25rem}
  .size-btn{min-height:48px;min-width:48px;padding:10px 14px;font-size:.84rem}
  .cart-drawer{width:100vw;right:-100vw}
  .bot-widget{bottom:80px;right:12px}
  .bot-chat{width:calc(100vw - 30px);max-width:310px}
  .ws-float{width:50px;height:50px;bottom:16px;right:16px}
  .bot-toggle{width:50px;height:50px}
}
@media(max-width:480px){
  .hero-slider{height:180px}
